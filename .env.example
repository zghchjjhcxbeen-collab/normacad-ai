# Скопировать в .env и заполнить. .env НЕ коммитить.
# Все переменные необязательны — у каждой есть dev-дефолт в app/config.py.

# --- Сессии и безопасность ---
SECRET_KEY=change-me-32-bytes-hex
SESSION_COOKIE_NAME=ncad_sid
SESSION_TTL_DAYS=30
# secure-cookie: 1 в проде (HTTPS). На localhost http оставить 0, иначе вход не работает.
COOKIE_SECURE=0

# --- БД ---
# dev по умолчанию: SQLite (sqlite+aiosqlite:///<root>/normacad.db).
# Прод: PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://normacad:normacad@localhost:5432/normacad
# Схема: dev — create_all; прод — миграции Alembic (требует USE_ALEMBIC=1 + alembic upgrade head).
USE_ALEMBIC=0

# --- Хранилище файлов и лимиты загрузки ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# --- База ГОСТов (справочник; вне репозитория) ---
GOST_DB_DIR=C:\Users\elisei\OneDrive\Desktop\БАЗА

# --- ИИ-чат со справочником по ГОСТ ---
# Бэкенд выбирается ПО ТИПУ пользователя: облако (claude) — только individual;
# bureau/enterprise — ТОЛЬКО локально (local) или офлайн-справочник (stub), в облако не уходят.
# stub (по умолчанию, без модели) | claude (нужен ключ) | local (нужен LOCAL_CHAT_URL)
CHAT_BACKEND=stub
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Локальная модель (OpenAI-совместимый endpoint). Приватно: запрос не покидает периметр.
# Пошаговая установка Ollama + модели: docs/local-chat-setup.md
# Проверка связи после установки: .\.venv\Scripts\python.exe scripts\check_local_chat.py
# Чтобы включить локальную модель для ВСЕХ: CHAT_BACKEND=local + LOCAL_CHAT_URL ниже.
# Примеры (раскомментировать нужный):
#   Ollama:     LOCAL_CHAT_URL=http://127.0.0.1:11434/v1   LOCAL_CHAT_MODEL=qwen2.5:7b
#   llama.cpp:  LOCAL_CHAT_URL=http://127.0.0.1:8080/v1    LOCAL_CHAT_MODEL=local-model
#   vLLM:       LOCAL_CHAT_URL=http://127.0.0.1:8001/v1    LOCAL_CHAT_MODEL=<имя_модели>
# ВНИМАНИЕ: сервис сам слушает порт 8000 — не вешайте локальную модель на 8000 (см. vLLM выше).
# Пусто → локального бэкенда нет (отдаётся офлайн-справочник из базы ГОСТ).
# LOCAL_CHAT_URL=http://127.0.0.1:11434/v1
LOCAL_CHAT_MODEL=qwen2.5:7b
